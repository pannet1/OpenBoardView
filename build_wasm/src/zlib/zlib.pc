prefix=/usr/share/emscripten/cache/sysroot
exec_prefix=/usr/share/emscripten/cache/sysroot
libdir=/usr/share/emscripten/cache/sysroot/lib
sharedlibdir=/usr/share/emscripten/cache/sysroot/lib
includedir=/usr/share/emscripten/cache/sysroot/include

